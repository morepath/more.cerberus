from collections.abc import Mapping
from typing import Any, NamedTuple, NoReturn, TypeVar, overload

from cerberus.validator import Validator

_T = TypeVar("_T")

class TypeDefinition(NamedTuple):
    name: str
    included_types: tuple[type, ...]
    excluded_types: tuple[type, ...]

def compare_paths_lt(x: tuple[Any, ...], y: tuple[Any, ...]) -> bool: ...
def drop_item_from_tuple(t: tuple[_T, ...], i: int) -> tuple[_T, ...]: ...
def get_Validator_class() -> type[Validator]: ...
def mapping_hash(schema: Mapping[Any, Any]) -> int: ...
def mapping_to_frozenset(mapping: Mapping[Any, Any]) -> frozenset[tuple[Any, Any]]: ...
@overload
def quote_string(value: str) -> str: ...
@overload
def quote_string(value: _T) -> _T: ...

class readonly_classproperty(property):
    def __get__(self, instance: Any, owner: type[Any]) -> Any: ...  # type: ignore[override]
    def __set__(self, instance: Any, value: Any) -> NoReturn: ...
    def __delete__(self, instance: Any) -> NoReturn: ...

def validator_factory(
    name: str,
    bases: type | tuple[type, ...] | None = None,
    namespace: dict[str, Any] = ...,
) -> type[Validator]: ...
