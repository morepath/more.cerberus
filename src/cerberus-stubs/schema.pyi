from collections.abc import ItemsView, Iterable, Iterator, Mapping, MutableMapping
from typing import Any, Self, TypeVar

from cerberus.utils import TypeDefinition as TypeDefinition
from cerberus.validator import Validator

_M = TypeVar("_M", bound=Mapping[Any, Any])

class _Abort(Exception): ...
class SchemaError(Exception): ...

class DefinitionSchema(MutableMapping[Any, Any]):
    validator: Validator
    validation_schema: SchemaValidationSchema
    schema_validator: Validator
    schema: MutableMapping[Any, Any]
    def __new__(cls, *args: Any, **kwargs: Any) -> Self: ...
    def __init__(
        self,
        validator: Validator,
        schema: Mapping[Any, Any] | str | Iterable[tuple[Any, Any]],
    ) -> None: ...
    def __delitem__(self, key: Any) -> None: ...
    def __getitem__(self, item: Any) -> Any: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __len__(self) -> int: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def copy(self) -> Self: ...
    @classmethod
    def expand(cls, schema: _M) -> _M: ...
    @classmethod
    def _expand_logical_shortcuts(cls, schema: _M) -> _M: ...
    @classmethod
    def _expand_subschemas(cls, schema: _M) -> _M: ...
    def get(self, item: Any, default: Any = None) -> Any: ...
    def items(self) -> ItemsView[Any, Any]: ...
    def update(self, schema: Mapping[Any, Any]) -> None: ...  # type: ignore[override]
    @staticmethod
    def _rename_deprecated_rulenames(schema: _M) -> _M: ...
    def regenerate_validation_schema(self) -> None: ...
    def validate(self, schema: Mapping[Any, Any] | str | None = None) -> None: ...
    def _validate(self, schema: Mapping[Any, Any] | str) -> None: ...

class UnvalidatedSchema(DefinitionSchema):
    def __init__(
        self, schema: Mapping[Any, Any] | Iterable[tuple[Any, Any]] = ...
    ) -> None: ...
    def validate(self, schema: Any) -> None: ...  # type: ignore[override]
    def copy(self) -> Self: ...

class SchemaValidationSchema(UnvalidatedSchema):
    def __init__(self, validator: Validator) -> None: ...

class SchemaValidatorMixin:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    @property
    def known_rules_set_refs(self) -> set[str]: ...
    @property
    def known_schema_refs(self) -> set[str]: ...
    @property
    def target_schema(self) -> Mapping[Any, Any]: ...
    @property
    def target_validator(self) -> Validator: ...
    def _check_with_bulk_schema(self, field: Any, value: Any) -> None: ...
    def _check_with_dependencies(self, field: Any, value: Any) -> None: ...
    def _check_with_items(self, field: Any, value: Any) -> None: ...
    def _check_with_schema(self, field: Any, value: Any) -> None: ...
    def _check_with_type(self, field: Any, value: Any) -> None: ...
    def _expand_rules_set_refs(self, schema: Mapping[Any, Any]) -> dict[Any, Any]: ...
    def _handle_schema_reference_for_validator(self, field: Any, value: Any) -> Any: ...
    def _validate_logical(self, rule: str, field: Any, value: Any) -> None: ...

class Registry:
    def __init__(
        self, definitions: Mapping[str, Any] | Iterable[tuple[str, Any]] = ...
    ) -> None: ...
    def add(self, name: str, definition: Mapping[Any, Any]) -> None: ...
    def all(self) -> dict[str, Any]: ...
    def clear(self) -> None: ...
    def extend(
        self, definitions: Mapping[str, Any] | Iterable[tuple[str, Any]]
    ) -> None: ...
    def get(self, name: str, default: Any = None) -> Any: ...
    def remove(self, *names: str) -> None: ...

class SchemaRegistry(Registry):
    @classmethod
    def _expand_definition(cls, definition: _M) -> _M: ...

class RulesSetRegistry(Registry):
    @classmethod
    def _expand_definition(cls, definition: Any) -> Any: ...

schema_registry: SchemaRegistry
rules_set_registry: RulesSetRegistry
